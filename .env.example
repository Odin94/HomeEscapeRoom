ADMIN_KEY=replace-with-a-long-random-key
# Optional bootstrap defaults. Admin UI settings override these.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=your-long-lived-access-token
# DATABASE_PATH=data/threshold.sqlite
# Entity mappings belong to games/*.json, configured in the Games UI.

# Optional local voice: install runtimes/models before enabling in GM Settings.
# VOICE_PYTHON=/absolute/path/to/data/voice/venv/bin/python
# VOICE_FFMPEG=/opt/homebrew/bin/ffmpeg
# VOICE_VAD_MODEL=/absolute/path/to/data/voice/models/silero-v6.0.onnx
# VOICE_PIPER_MODEL=/absolute/path/to/data/voice/models/en_US-ljspeech-high.onnx
# VOICE_WHISPER_SERVER=/absolute/path/to/whisper.cpp/build/bin/whisper-server
# VOICE_WHISPER_MODEL=/absolute/path/to/data/voice/models/ggml-base.bin
